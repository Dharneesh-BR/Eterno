{
  "name": "eterno",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:prod": "node ./node_modules/vite/bin/vite.js build --mode production",
    "preview": "vite preview",
    "preview:prod": "vite preview --mode production --port 3000",
    "test:prod": "npm run build:prod && npm run preview:prod",
    "vercel-build": "node vercel-build.js",
    "debug:modules": "echo 'Checking installed modules...' && ls -la node_modules/tailwindcss && ls -la node_modules/postcss && ls -la node_modules/autoprefixer",
    "icons": "node scripts/generate-icons.mjs",
    "optimize-images": "node scripts/optimize-images.mjs",
    "performance:audit": "node scripts/performance-monitor.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@heroicons/react": "^2.2.0",
    "@portabletext/react": "^4.0.2",
    "@sanity/client": "^7.10.0",
    "@sanity/image-url": "^1.2.0",
    "@sendgrid/mail": "^8.1.6",
    "@supabase/supabase-js": "^2.98.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.21",
    "axios": "^1.13.6",
    "crypto": "^1.0.1",
    "emailjs-com": "^3.2.0",
    "esbuild": "^0.25.9",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.6.1",
    "framer-motion": "^12.34.3",
    "gsap": "^3.14.2",
    "i18next": "^25.6.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.575.0",
    "postcss": "^8.5.6",
    "postcss-cli": "^10.0.0",
    "postcss-import": "^15.1.0",
    "postcss-nesting": "^12.1.2",
    "razorpay": "^2.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^16.3.3",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.30.1",
    "swiper": "^11.2.10",
    "tailwindcss": "^3.4.17",
    "terser": "^5.43.1"
  },
  "devDependencies": {
    "vite": "^7.3.1"
  }
}
